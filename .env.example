## SMTP para envío REAL (solo local)
# Copiá este archivo a `.env` y completá tus credenciales.
# .env está ignorado por git en este repo.

# Hostinger (legacy) — preferir Brevo en producción
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=587
# MAIL_USER=no-reply@groboapp.com
# MAIL_PASS=...
# MAIL_SECURE=tls

# Brevo SMTP: usar login y clave SMTP, no API key
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=tu_login_smtp_brevo
MAIL_PASS=tu_clave_smtp_brevo
MAIL_FROM=no-reply@groboapp.com
MAIL_FROM_NAME=GROBO
MAIL_DEBUG=0
# 0 = no enviar mails (emergencia). 1 = normal.
# Con MAIL_ENABLED=0 el login de admin/superadmin no pide código 2FA (no hay SMTP).
MAIL_ENABLED=1
# Temporal: 1 = sin confirmación de registro ni 2FA por correo. En prod normal: 0
GROBO_SKIP_EMAIL_AUTH=0

# Topes anti-flood SMTP (opcionales; estos son los defaults del código)
# MAIL_RATE_GLOBAL_PER_MIN=40
# MAIL_RATE_GLOBAL_PER_HOUR=180
# MAIL_RATE_IP_PER_10MIN=10
# MAIL_RATE_IP_PER_HOUR=40
# MAIL_RATE_TO_PER_10MIN=3
# MAIL_RATE_TO_PER_HOUR=8
# MAIL_MAX_RECIPIENTS_PER_REQUEST=25

# Alternativas:
# - TLS: MAIL_SECURE=tls (puerto 587)
# - SSL: MAIL_SECURE=ssl (puerto 465)

# --- IA (GROBO / Gemini) ---
# Opcional: restringir quién puede llamar a POST /ia/procesar (roles numéricos IdTipousrA, separados por coma).
# Si no se define o se deja vacío, cualquier sesión válida puede usar el asistente (comportamiento histórico).
# Ejemplo solo personal admin de sede y lab: GROBO_IA_ALLOWED_ROLES=4,5,6
# GROBO_IA_ALLOWED_ROLES=

# Desactiva el filtro estricto y permite llamar a Gemini aunque el texto no lleve palabras clave GROBO (solo pruebas).
# GROBO_IA_RELAXED_GEMINI=0

